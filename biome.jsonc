{
  "$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    // The HTML pages keep their hand-formatted style until each is reformatted (AGENTS.md, Code style). tools/trailer is its
    // own package. .github and .claude stay out because check.yml skips PRs that only change them, so such an edit could
    // merge unformatted and fail on main.
    "includes": ["**", "!**/*.md", "!src/*.html", "!data", "!tools/trailer", "!.github", "!.claude"]
  },
  // Indent style and width come from .editorconfig, so editors and Biome can't disagree.
  "formatter": { "useEditorconfig": true, "lineWidth": 120 },
  // __BUILD__ is the commit sha that vite.config.ts writes into the pages (src/build.d.ts).
  "javascript": { "formatter": { "quoteStyle": "single", "arrowParentheses": "asNeeded" }, "globals": ["__BUILD__"] },
  "linter": {
    "rules": {
      // Recommended only warns on these; `biome check --error-on-warnings` (package.json) fails on the rest too.
      "correctness": { "noUnusedVariables": "error", "noUnusedImports": "error" },
      // `getObjectByName(...)!` and string `+` are the house style in the dense code; flagging them is only noise.
      "style": { "noNonNullAssertion": "off", "useTemplate": "off" }
    }
  },
  // The architecture rules in AGENTS.md that a linter can check. Rule 5 is here; rules 2 and 3 are in the overrides.
  "plugins": [
    // Rule 5: seeded randomness in the game and the world. The map page isn't gameplay, and neither are tools and tests.
    { "path": "./tools/biome/no-math-random.grit", "includes": ["src/**", "!src/map/**"] }
  ],
  "overrides": [
    {
      // The two page scripts keep their dense style, so only formatting is off: reformatting the game's main.ts is its own
      // PR now that #177 has split it. These rules still run: the map's @ts-nocheck hides undeclared names from tsc, and a
      // move that takes a name out of a main.ts while another branch still uses it would otherwise only fail at runtime.
      "includes": ["src/game/main.ts", "src/map/main.ts"],
      "formatter": { "enabled": false },
      "assist": { "enabled": false },
      "linter": {
        "rules": {
          "recommended": false,
          "correctness": { "noUndeclaredVariables": "error", "noUnusedVariables": "error", "noUnusedImports": "error" }
        }
      }
    },
    {
      // Rules 2 and 3 on the world and the simulation: they know nothing about the page, so they run in Node, a worker or
      // a server, and they read intents, not input. These are fallow.toml's world, world-mesh and sim zones: all of
      // src/world/, and src/game/ outside render/, presentation/ and the page modules. tsconfig.sim.json has the same paths: keep the
      // three lists the same (tests/unit/zones.test.ts checks). Fallow checks the imports between our own files; Biome and tsc check what Fallow can't see.
      "includes": [
        "src/world/**",
        "src/game/**",
        "!src/game/render/**",
        "!src/game/presentation/**",
        "!src/game/main.ts",
        "!src/game/hud.ts",
        "!src/game/input.ts",
        "!src/game/menu.ts",
        "!src/game/pause-menu.ts",
        "!src/game/loop.ts",
        "!src/game/prompt.ts",
        "!src/game/test-hook.ts",
        "!src/game/capture-hook.ts",
        "!src/game/devconsole.ts",
        "!src/game/confetti.ts"
      ],
      "plugins": [
        // Rule 2: a listener on any object, such as an element passed in, which noRestrictedGlobals can't see.
        "./tools/biome/no-dom-listeners.grit",
        // Rule 3: only the input module reads keys, mouse, touch and gamepads.
        "./tools/biome/intents-not-keys.grit"
      ],
      "linter": {
        "rules": {
          "style": {
            // Rule 2, the page's globals: the common ones, so they show in the editor. tsc without the DOM library
            // (tsconfig.sim.json) rejects all of them in npm run check, so this list needn't grow.
            "noRestrictedGlobals": {
              "level": "error",
              "options": {
                // Biome 2.6.8 doesn't print these values; its message names the global and the option instead.
                "deniedGlobals": {
                  "window": "rule 2",
                  "self": "rule 2",
                  "document": "rule 2",
                  "globalThis": "rule 2",
                  "navigator": "rule 2",
                  "location": "rule 2",
                  "localStorage": "rule 2",
                  "sessionStorage": "rule 2",
                  "fetch": "rule 2",
                  "requestAnimationFrame": "rule 2",
                  "cancelAnimationFrame": "rule 2",
                  "addEventListener": "rule 2",
                  "removeEventListener": "rule 2",
                  "HTMLElement": "rule 2",
                  "HTMLCanvasElement": "rule 2",
                  "Image": "rule 2",
                  "AudioContext": "rule 2"
                }
              }
            },
            // Rule 2 for imports: three.js stays in src/game/render/ and the world's three.js side (the next override).
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["three", "three/**"],
                    "message": "Keep three.js in src/game/render/ or src/world/mesh/; sim and world code is plain data and functions (rule 2)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      // The world's three.js side may import it. Exceptions: cats build their own meshes, and pedestrians add theirs to the
      // scene; drop each once #49 moves that into render/.
      "includes": ["src/world/mesh/**", "src/world/three-legacy.ts", "src/game/cats.ts", "src/game/pedestrians.ts"],
      "linter": { "rules": { "style": { "noRestrictedImports": "off" } } }
    },
    {
      // Rule 3 in rendering too: it draws the sim's state, and input reaches it as intents like everything else.
      "includes": ["src/game/render/**"],
      "plugins": ["./tools/biome/intents-not-keys.grit"]
    }
  ]
}
