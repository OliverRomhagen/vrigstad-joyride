{
  "name": "vrigstad-joyride",
  "private": true,
  "description": "Open-world driving game set in Vrigstad, Sweden",
  "type": "module",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "node tools/build.mjs",
    "preview": "vite preview",
    "check": "tsc --noEmit && tsc --noEmit -p tsconfig.tests.json",
    "data": "python3 tools/process.py data/raw data/vrigstad.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "compress:vehicles": "node tools/compress-vehicles.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "24.19.2",
    "@types/three": "0.187.0",
    "gltfpack": "1.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "three": "0.187.0"
  }
}
